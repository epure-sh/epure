# Integration tests — Postgres must be reachable on the host port below.
# `./scripts/test.sh` loads `.env` / `.env.dev` when present, else uses these defaults.
#
# For full local dev vars see `deploy/env.dev.example`.

POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://epure:epure@localhost:5433/epure
EPURE_SESSION_SECURE=0
