# Production — copy to `.env` on your VPS:
#   cp deploy/env.production.example .env
#   # fill every CHANGE_ME (or run ./configure --prod)
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml --profile tls up -d
#
# SIGN-IN: open https://YOUR_HOSTNAME/login
# Do not open http://YOUR_SERVER:8080. /health works there, login does not.
# The prod overlay sets a Secure cookie. Browsers drop it on HTTP and send
# you back to the form with no error.
#
# --profile tls starts Caddy (deploy/Caddyfile) on ports 80 and 443.
# EPURE_PUBLIC_URL must be https:// and a DNS name, not a raw IP.
# Drop --profile tls only if nginx, Caddy, or Traefik already serves that URL.
# Example passwords are refused unless EPURE_PUBLIC_URL is localhost.

# ━━━ Required ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

EPURE_PORT=8080
EPURE_PUBLIC_URL=https://errors.example.com
# Hostname only. Required when you start Caddy with `--profile tls`.
EPURE_SITE_ADDRESS=errors.example.com
EPURE_CORS_ORIGINS=https://errors.example.com

POSTGRES_PASSWORD=CHANGE_ME          # openssl rand -hex 24
EPURE_INGEST_PASSWORD=CHANGE_ME
EPURE_APP_PASSWORD=CHANGE_ME

# Postgres applies POSTGRES_PASSWORD only on an empty data volume. After the
# first boot, keep these three values in sync with the database — or run
# ./configure --sync-db-passwords after editing .env by hand.
# ./configure --prod reuses secrets when a volume exists; use
# ./configure --prod-rotate-secrets to rotate intentionally.

# ━━━ Optional ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# EPURE_IMAGE=ghcr.io/epure-sh/epure:v0.1.7  # pin a release tag; see https://github.com/epure-sh/epure/releases

# After the first account exists, block new workspaces from the public URL.
# Login and invitation links still work.
# EPURE_REGISTRATION=false

# Reverse proxy addresses allowed to set X-Forwarded-For (login limits and event IPs).
# Example when Caddy on the host reaches the container via the docker bridge:
# EPURE_TRUSTED_PROXIES=172.17.0.1

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://errors.example.com/api/v1/auth/google/callback
