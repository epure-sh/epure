{
  "name": "epure-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite --config vite.playground.config.ts",
    "build": "tsc -b tsconfig.app.json && vite build",
    "build:playground": "tsc -b tsconfig.playground.json && vite build --config vite.playground.config.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'playground/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:playground-smoke": "playwright test --config playwright.playground.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.app.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
