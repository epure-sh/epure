# Epure — optional Compose overrides
#
# You do NOT need this file. Defaults work:
#   docker compose up  →  http://localhost:8080
#
# Copy only when something on your machine conflicts:
#   cp .env.example .env
#
# On localhost, EPURE_PUBLIC_URL is derived from EPURE_PORT automatically.
# Set EPURE_PUBLIC_URL only for ngrok, a custom hostname, or production HTTPS.
#
# Production VPS: use .env.production.example or  ./configure --prod
# Cargo / tests:  use .env.dev.example (not read by Compose)

# ── Ports (change if 8080 or 5433 is taken) ─────────────────────

EPURE_PORT=8080
# POSTGRES_HOST_PORT=5433

# ── Optional ──────────────────────────────────────────────────────

# Pin a release:
# EPURE_IMAGE=ghcr.io/epure-sh/epure:v0.1.0-phase1

# Demo issues on startup (localhost only):
# EPURE_DEV_SEED=1

# Frontend dev server (default ingest CORS is *):
# EPURE_CORS_ORIGINS=http://localhost:5173

# Custom public URL (ngrok, etc.):
# EPURE_PUBLIC_URL=https://abc123.ngrok-free.app

# Google OAuth (leave empty for email/password):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
