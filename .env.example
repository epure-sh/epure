# Copy to .env and edit. Compose interpolates this file.
# `docker compose up` works with no .env (defaults below; pulls GHCR).
#
# Pin a release (optional):
# EPURE_IMAGE=ghcr.io/epure-sh/epure:v0.1.0-phase1

# --- Host ports (change these; keep PUBLIC_URL in sync with EPURE_PORT) ---
EPURE_PORT=8080
POSTGRES_HOST_PORT=5433
EPURE_PUBLIC_URL=http://localhost:8080

# --- App ---
EPURE_CORS_ORIGINS=*
# 0 on local HTTP. Prod overlay forces 1 (needs HTTPS).
EPURE_SESSION_SECURE=0
# EPURE_DEV_SEED=1
# EPURE_WEBHOOK_ALLOW_PRIVATE=1

# Cloud only — leave empty for OSS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty → `{EPURE_PUBLIC_URL}/api/v1/auth/google/callback`
GOOGLE_REDIRECT_URI=

# --- Host-side cargo / tests (Compose injects postgres:5432 URLs in the container) ---
# Keep the host port here equal to POSTGRES_HOST_PORT.
DATABASE_URL=postgres://epure:epure@localhost:5433/epure
EPURE_INGEST_DATABASE_URL=postgres://epure_ingest:epure_ingest@localhost:5433/epure
EPURE_APP_DATABASE_URL=postgres://epure_app:epure_app@localhost:5433/epure
EPURE_BIND=0.0.0.0:8080
EPURE_MODE=all
# Required for the documented local-dev passwords in a --release / compose image.
EPURE_ALLOW_EXAMPLE_PASSWORDS=1
EPURE_ARTIFACTS_DIR=/data/artifacts
# EPURE_DB_CONNECT_MAX_ATTEMPTS=30

# --- Production overlay ---
# On a VPS copy `.env.production.example` instead of this file.
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Example passwords are refused when EPURE_PUBLIC_URL is not localhost.
