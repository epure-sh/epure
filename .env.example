DATABASE_URL=postgres://epure:epure@localhost:5433/epure
EPURE_INGEST_DATABASE_URL=postgres://epure_ingest:epure_ingest@localhost:5433/epure
EPURE_APP_DATABASE_URL=postgres://epure_app:epure_app@localhost:5433/epure
EPURE_BIND=0.0.0.0:8080
EPURE_MODE=all
# EPURE_DEV_SEED=1
EPURE_CORS_ORIGINS=*
EPURE_ARTIFACTS_DIR=/data/artifacts
# Set to 0 for HTTP localhost dev; use 1 behind HTTPS in production.
EPURE_SESSION_SECURE=0
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
EPURE_PUBLIC_URL=http://localhost:8080
# Allow http://127.0.0.1 webhook targets in local dev/tests only.
# EPURE_WEBHOOK_ALLOW_PRIVATE=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
